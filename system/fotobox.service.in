[Unit]
Description=Fotobox Flask App (Raspberry Pi + Canon EOS)
# Nicht auf network-online warten: die App soll auch ohne WLAN (Hotspot-Modus)
# sofort erreichbar sein. Sie lauscht auf 0.0.0.0.
After=network.target NetworkManager.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/venv/bin/python @DIR@/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
