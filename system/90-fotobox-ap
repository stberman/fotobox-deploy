#!/bin/bash
# NetworkManager-Dispatcher (wird bei jedem Verbindungs-Ereignis aufgerufen).
#
# Sorgt dafuer, dass Port 80 auf die Fotobox-App (5000) umgeleitet wird:
#   http://fotobox.local  und  http://10.42.0.1  funktionieren ohne ":5000".
# Im Hotspot-Modus ist das zugleich das Captive-Portal: Handys fragen beim
# Verbinden eine HTTP-Testseite (Port 80) ab, landen bei der App und bekommen
# von dort einen Redirect auf /wlan -> "Im Netzwerk anmelden"-Popup.
#
# Die Regel ist idempotent (Tabelle wird neu angelegt) und harmlos, daher bei
# jedem 'up' setzen - unabhaengig vom Interface.
IFACE="${1:-}"
ACTION="${2:-}"

case "$ACTION" in
  up)
    # Tunnel nur mit "echter" Verbindung: im Hotspot stoppen, sonst (neu) starten.
    # Im Autark-Modus verweigert die Unit den Start selbst (ConditionPathExists).
    if [ "${CONNECTION_ID:-}" = "Fotobox-AP" ]; then
      systemctl stop --no-block fotobox-tunnel 2>/dev/null || true
    elif [ "$IFACE" != "lo" ]; then
      systemctl start --no-block fotobox-tunnel 2>/dev/null || true
    fi
    command -v nft >/dev/null 2>&1 || exit 0
    nft -f - <<'EOF'
table ip fotobox
delete table ip fotobox
table ip fotobox {
  chain prerouting {
    type nat hook prerouting priority -100; policy accept;
    tcp dport 80 redirect to :5000
  }
}
EOF
    ;;
esac
exit 0
